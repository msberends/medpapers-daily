app_name: Papers Daily
base_url: http://localhost:2711
port: 2711
db_path: data/paperdigest.db
log_path: logs/fetch.log

# Elsevier Scopus API key — required to run the journal harvest (Admin > Journal Rankings).
# Free API keys are available at https://dev.elsevier.com/
elsevier_api_key: ''
lookback_days: 7

# Get a free NCBI API key at https://www.ncbi.nlm.nih.gov/account/
ncbi_api_key: ''
ncbi_email: ''

# SMTP settings (example uses Gmail App Password)
smtp_host: smtp.gmail.com
smtp_port: 587
smtp_user: ''
smtp_password: ''
email_relay: smtp
email_from: noreply@example.com
# Available placeholders: {new_papers}, {s} ("s" if >1 paper, "" otherwise),
#   {date}, {name} (display name), {display_name} (same as {name}), {username}, {app_name}
email_subject_template: '{new_papers} new paper{s} in your digest ({date})'

# Optional: institutional proxy prefix for paywalled links
proxy_enabled: false
proxy_domain: ''
proxy_url_regex: ''

# Publisher display (managed via Admin > Publishers tab)
# Maps full PubMed publisher names to shorter display names shown everywhere in the UI and emails
publisher_map: {}
#   Example:
#   Springer Nature: Springer
#   Frontiers Media SA: Frontiers

# Publishers flagged as predatory or suspicious; their names render in muted red
predatory_publishers: []
#   Example:
#   - MDPI
#   - Hindawi

# UI
bootstrap_theme: yeti   # any Bootswatch theme name
theme: light            # light or dark
timezone: UTC           # IANA timezone, e.g. Europe/Amsterdam
