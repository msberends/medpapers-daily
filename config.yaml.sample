app_name: MedPapers Daily
base_url: http://localhost:2711
port: 2711
db_path: data/paperdigest.db
log_path: logs/fetch.log

# Elsevier Scopus API key — required to run the journal harvest (Admin > Journal Rankings).
# Free API keys are available at https://dev.elsevier.com/
elsevier_api_key: ''
lookback_days: 7

# Get a free NCBI API key at https://www.ncbi.nlm.nih.gov/account/
ncbi_api_key: ''
ncbi_email: ''

# SMTP settings (example uses Gmail App Password)
smtp_host: smtp.gmail.com
smtp_port: 587
smtp_user: ''
smtp_password: ''
email_relay: smtp
email_from: noreply@example.com
# Available placeholders: {new_papers}, {s} ("s" if >1 paper, "" otherwise),
#   {date}, {name} (display name), {display_name} (same as {name}), {username}, {app_name}
email_subject_template: '{new_papers} new paper{s} in your digest ({date})'

# Optional: institutional proxy prefix for paywalled links
proxy_enabled: false
proxy_domain: ''
proxy_url_regex: ''

# Publisher display (managed via Admin > Publishers tab)
# Maps full PubMed publisher names to shorter display names shown everywhere in the UI and emails
publisher_map: {}
#   Example:
#   Springer Nature: Springer
#   Frontiers Media SA: Frontiers

# Publishers flagged as predatory or suspicious; their names render in muted red
predatory_publishers: []
#   Example:
#   - MDPI
#   - Hindawi

# UI
bootstrap_theme: yeti   # any Bootswatch theme name (Bootswatch palette)
# Per-user dark/light mode is set in each user's settings page (stored in users/<username>.yaml as theme_mode)
timezone: UTC           # IANA timezone, e.g. Europe/Amsterdam

# LLM integration — abstract highlights and search profile suggestions
# Set llm_provider to 'claude', 'chatgpt', or 'ollama' to enable. Leave blank to disable.
# Model lists: Claude → https://docs.anthropic.com/en/docs/about-claude/models/overview
#              ChatGPT → https://platform.openai.com/docs/models
#              Ollama → run 'ollama list' or see https://ollama.com/library
llm_provider: ''
llm_api_key: ''                          # Claude or OpenAI API key
llm_ollama_url: 'http://localhost:11434' # Ollama base URL (ignored for claude/chatgpt)
llm_model: ''                            # e.g. claude-sonnet-4-6, gpt-4o, llama3.2
llm_timeout: 120                         # seconds to wait for a response (increase for large local models)
# System prompt for abstract highlights. The abstract is sent as the user message.
llm_prompt: |
  You summarise scientific abstracts. When given an abstract, respond with up to
  5 concise bullet-point highlights capturing the key findings, methods, and
  conclusions. Each highlight is one short sentence. Return only the bullet
  points, one per line, each starting with a dash (-). No introduction, no
  numbering, no trailing commentary. Use British English spelling throughout
  (e.g. -ise not -ize, colour not color).
# Allow users to send their Search Profile improvement prompts through the LLM.
llm_allow_profile_optimisation: false
# Allow users to use the LLM to suggest term-to-topic assignments in their Topics settings.
# Suggestions are shown for confirmation before any changes are applied.
llm_allow_topic_suggestions: false
