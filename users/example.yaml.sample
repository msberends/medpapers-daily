email: user@example.com
email_suppress_empty: false        # true = skip the email when nothing new today
email_only_new: true               # true = only include papers not yet in any previous digest
email_group_by_profile: false      # true = divide digest into sections per search profile
fetch_enabled: true

# Scopus quartile filtering (requires journal harvest to have been run via Admin > Journal Rankings)
q1_soft: true    # show Q1 papers (always included)
q2_hard: true    # drop Q3/Q4 papers; keep Q1+Q2

# PubMed search profiles — at least one needed for fetch.py to do anything
search_profiles:
  - name: Example Search
    query: '"antimicrobial resistance"[MeSH] AND (software OR bioinformatics)'
    enabled: true

# Term → topic label mapping used for in-app classification.
# Matches both MeSH headings (assigned by NLM indexers) and author keywords
# (provided at submission, often present before MeSH indexing is complete).
# All matches are exact and case-sensitive. Copy MeSH headings from
# https://www.ncbi.nlm.nih.gov/mesh/ and author keywords from the paper detail page.
mesh_topic_map:
  Anti-Bacterial Agents: AMR
  antimicrobial resistance: AMR
  Machine Learning: AI

# Colour assigned to each topic in the web UI.
# Values: primary, success, danger, warning, info, secondary, purple, teal
mesh_topic_colours:
  AMR: primary
  AI: success

# Per-user UI overrides (optional; inherits from config.yaml if omitted)
folders: []
bootstrap_theme: yeti
theme_mode: ''                     # '' or 'light' = light mode (default); 'dark' = dark; 'system' = follow device preference
show_quartile: true
show_flags: true                   # true = show country flag per author on paper detail page
show_flags_feed: true              # true = show country flag per author in feed cards
show_export_ris: true              # true = show "Export RIS" button on paper page and feed bulk actions
show_export_nbib: false            # true = show "Open in EndNote" button (downloads .nbib file)
abstract_style: accent             # accent | pill — layout style for structured abstract section headings
feed_group_by_profile: false       # true = group feed papers by search profile with section headers
fetch_schedule: daily   # daily | weekly | monthly
fetch_schedule_dow: 0   # 0=Mon … 6=Sun (weekly only)
fetch_schedule_dom: 1   # 1-28 (monthly only)
page_size: 25
lookback_days: 7

# Relevance alerts — shown on the feed when a search profile's relevant% falls below the threshold
relevance_alert_enabled: true
relevance_alert_threshold: 0.30   # alert when relevant% drops below this fraction
relevance_alert_min_rated: 10     # minimum rated papers before alerting
relevance_alert_lookback_days: 30 # rolling window in days
